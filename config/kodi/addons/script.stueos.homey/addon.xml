<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.stueos.homey" name="StueOS Homey Integration" version="1.0.0" provider-name="StueOS">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary>Trigger Homey flows when media starts/stops</summary>
    <description>Integrates Kodi events with Homey for automated lighting scenes.</description>
    <platform>all</platform>
  </extension>
</addon>
