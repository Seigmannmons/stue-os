<?xml version="1.0" encoding="UTF-8"?>
<!--
  StueOS Fusion — EmulationStation-DE Theme
  Compatible with ES-DE 2.x
  Amber accent (#e8a63c) on deep-space dark (#0a0c10)
-->
<theme>

  <!-- ═══ COLOR VARIABLES ═══ -->
  <variables>
    <colorBg>0a0c10ff</colorBg>
    <colorBg2>0d1017ff</colorBg2>
    <colorSurface>131620ff</colorSurface>
    <colorSurface2>181c2aff</colorSurface2>
    <colorBorder>24284080</colorBorder>
    <colorAmber>e8a63cff</colorAmber>
    <colorAmberDim>e8a63c40</colorAmberDim>
    <colorAmberBright>f0bc6eff</colorAmberBright>
    <colorBlue>4a8fd4ff</colorBlue>
    <colorGreen>56c47aff</colorGreen>
    <colorText>dde2f0ff</colorText>
    <colorTextMuted>8893a8ff</colorTextMuted>
    <colorTextDim>2e3448ff</colorTextDim>
    <fontRegular>./../fonts/Inter-Regular.ttf</fontRegular>
    <fontBold>./../fonts/Inter-Bold.ttf</fontBold>
    <fontHeading>./../fonts/SpaceGrotesk-SemiBold.ttf</fontHeading>
  </variables>

  <!-- ═══ ASPECT RATIO ═══ -->
  <aspectRatio name="16:9">

    <!-- ─── SYSTEM VIEW ─── -->
    <view name="system">

      <!-- Background -->
      <image name="background">
        <pos>0 0</pos>
        <size>1 1</size>
        <color>${colorBg}</color>
        <zIndex>0</zIndex>
      </image>

      <!-- Subtle ambient gradient -->
      <image name="bg-gradient">
        <pos>0 0</pos>
        <size>1 0.5</size>
        <color>${colorSurface}80</color>
        <zIndex>1</zIndex>
      </image>

      <!-- System carousel -->
      <carousel name="systemcarousel">
        <pos>0 0.3</pos>
        <size>1 0.4</size>
        <color>${colorBg}</color>
        <colorEnd>${colorBg2}</colorEnd>
        <gradientType>horizontal</gradientType>
        <logoSize>0.25 0.1</logoSize>
        <logoMaxSize>0.4 0.15</logoMaxSize>
        <logoScale>1.3</logoScale>
        <logoRotation>7.5</logoRotation>
        <logoRotationOrigin>-5 0.5</logoRotationOrigin>
        <logoAlignment>center</logoAlignment>
        <maxLogoCount>5</maxLogoCount>
        <unfocusedLogoOpacity>0.6</unfocusedLogoOpacity>
        <selectedColor>${colorAmber}</selectedColor>
        <unselectedColor>${colorTextMuted}</unselectedColor>
        <reflections>false</reflections>
        <reflectionsOpacity>0</reflectionsOpacity>
        <zIndex>5</zIndex>
      </carousel>

      <!-- System name -->
      <text name="systemname">
        <pos>0.5 0.76</pos>
        <size>0.8 0.07</size>
        <origin>0.5 0.5</origin>
        <fontPath>${fontHeading}</fontPath>
        <fontSize>0.04</fontSize>
        <color>${colorText}</color>
        <horizontalAlignment>center</horizontalAlignment>
        <letterCase>capitalize</letterCase>
        <zIndex>10</zIndex>
      </text>

      <!-- Game count -->
      <text name="gamecount">
        <pos>0.5 0.84</pos>
        <size>0.6 0.04</size>
        <origin>0.5 0.5</origin>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.022</fontSize>
        <color>${colorTextMuted}</color>
        <horizontalAlignment>center</horizontalAlignment>
        <zIndex>10</zIndex>
      </text>

      <!-- Amber accent line under selected system -->
      <image name="selector-line">
        <pos>0.35 0.73</pos>
        <size>0.3 0.003</size>
        <color>${colorAmber}</color>
        <zIndex>8</zIndex>
      </image>

      <!-- Clock / status bar -->
      <datetime name="clock">
        <pos>0.97 0.03</pos>
        <size>0.1 0.04</size>
        <origin>1 0</origin>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.022</fontSize>
        <color>${colorTextMuted}</color>
        <horizontalAlignment>right</horizontalAlignment>
        <format>%H:%M</format>
        <zIndex>20</zIndex>
      </datetime>

      <!-- Help bar background -->
      <image name="help-bg">
        <pos>0 0.93</pos>
        <size>1 0.07</size>
        <color>${colorBg2}</color>
        <zIndex>15</zIndex>
      </image>

      <!-- Help bar separator line -->
      <image name="help-line">
        <pos>0 0.93</pos>
        <size>1 0.002</size>
        <color>${colorBorder}</color>
        <zIndex>16</zIndex>
      </image>

      <helpsystem name="help">
        <pos>0.5 0.965</pos>
        <origin>0.5 0.5</origin>
        <textColor>${colorTextMuted}</textColor>
        <textColorDimmed>${colorTextDim}</textColorDimmed>
        <iconColor>${colorAmber}</iconColor>
        <iconColorDimmed>${colorAmberDim}</iconColorDimmed>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.02</fontSize>
        <entrySpacing>0.015</entrySpacing>
        <letterCase>lowercase</letterCase>
        <zIndex>20</zIndex>
      </helpsystem>

    </view>

    <!-- ─── GAMELIST VIEW ─── -->
    <view name="gamelist">

      <!-- Background -->
      <image name="background">
        <pos>0 0</pos>
        <size>1 1</size>
        <color>${colorBg}</color>
        <zIndex>0</zIndex>
      </image>

      <!-- Left sidebar background -->
      <image name="sidebar-bg">
        <pos>0 0</pos>
        <size>0.28 1</size>
        <color>${colorBg2}</color>
        <zIndex>1</zIndex>
      </image>

      <!-- Sidebar right border -->
      <image name="sidebar-border">
        <pos>0.28 0</pos>
        <size>0.002 1</size>
        <color>${colorBorder}</color>
        <zIndex>2</zIndex>
      </image>

      <!-- Game list -->
      <textlist name="gamelist">
        <pos>0.01 0.1</pos>
        <size>0.26 0.78</size>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.025</fontSize>
        <color>${colorText}</color>
        <colorSecondary>${colorTextMuted}</colorSecondary>
        <selectedColor>${colorAmber}</selectedColor>
        <selectedBackgroundColor>${colorAmberDim}</selectedBackgroundColor>
        <selectedSecondaryColor>${colorAmberBright}</selectedSecondaryColor>
        <selectorColor>00000000</selectorColor>
        <selectorColorEnd>00000000</selectorColorEnd>
        <selectorHeight>0.032</selectorHeight>
        <selectorHorizontalOffset>-0.01</selectorHorizontalOffset>
        <selectedItemMargins>0 0</selectedItemMargins>
        <lineSpacing>1.5</lineSpacing>
        <scrollIndicatorType>symbol</scrollIndicatorType>
        <letterCase>none</letterCase>
        <zIndex>5</zIndex>
      </textlist>

      <!-- System label top-left -->
      <text name="system-label">
        <pos>0.01 0.02</pos>
        <size>0.26 0.06</size>
        <fontPath>${fontHeading}</fontPath>
        <fontSize>0.028</fontSize>
        <color>${colorAmber}</color>
        <horizontalAlignment>left</horizontalAlignment>
        <letterCase>capitalize</letterCase>
        <zIndex>10</zIndex>
      </text>

      <!-- Game artwork (cover) -->
      <image name="cover">
        <pos>0.31 0.08</pos>
        <size>0.22 0.5</size>
        <origin>0 0</origin>
        <imageType>cover</imageType>
        <interpolation>linear</interpolation>
        <cornerRadius>0.006</cornerRadius>
        <defaultImage>:/graphics/no_cover.svg</defaultImage>
        <zIndex>10</zIndex>
      </image>

      <!-- Game info area -->
      <text name="game-title">
        <pos>0.555 0.08</pos>
        <size>0.42 0.08</size>
        <fontPath>${fontHeading}</fontPath>
        <fontSize>0.038</fontSize>
        <color>${colorText}</color>
        <horizontalAlignment>left</horizontalAlignment>
        <textWrap>true</textWrap>
        <letterCase>none</letterCase>
        <zIndex>10</zIndex>
        <metadata>name</metadata>
      </text>

      <text name="game-genre">
        <pos>0.555 0.19</pos>
        <size>0.42 0.04</size>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.022</fontSize>
        <color>${colorTextMuted}</color>
        <horizontalAlignment>left</horizontalAlignment>
        <zIndex>10</zIndex>
        <metadata>genre</metadata>
      </text>

      <text name="game-year">
        <pos>0.555 0.235</pos>
        <size>0.1 0.04</size>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.022</fontSize>
        <color>${colorTextMuted}</color>
        <horizontalAlignment>left</horizontalAlignment>
        <zIndex>10</zIndex>
        <metadata>releasedate</metadata>
        <format>%Y</format>
      </text>

      <!-- Rating stars -->
      <rating name="rating">
        <pos>0.555 0.285</pos>
        <size>0 0.03</size>
        <filledColor>${colorAmber}</filledColor>
        <unfilledColor>${colorTextDim}</unfilledColor>
        <zIndex>10</zIndex>
      </rating>

      <!-- Description -->
      <text name="description">
        <pos>0.555 0.34</pos>
        <size>0.42 0.3</size>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.021</fontSize>
        <color>${colorTextMuted}</color>
        <horizontalAlignment>left</horizontalAlignment>
        <textWrap>true</textWrap>
        <lineSpacing>1.5</lineSpacing>
        <containerType>scroll</containerType>
        <containerScrollSpeed>50</containerScrollSpeed>
        <containerStartDelay>4</containerStartDelay>
        <containerResetDelay>5</containerResetDelay>
        <zIndex>10</zIndex>
        <metadata>description</metadata>
      </text>

      <!-- Bottom info bar -->
      <image name="info-bar-bg">
        <pos>0.282 0.93</pos>
        <size>0.72 0.07</size>
        <color>${colorBg2}</color>
        <zIndex>15</zIndex>
      </image>

      <image name="info-bar-line">
        <pos>0.282 0.93</pos>
        <size>0.72 0.002</size>
        <color>${colorBorder}</color>
        <zIndex>16</zIndex>
      </image>

      <helpsystem name="help">
        <pos>0.98 0.965</pos>
        <origin>1 0.5</origin>
        <textColor>${colorTextMuted}</textColor>
        <textColorDimmed>${colorTextDim}</textColorDimmed>
        <iconColor>${colorAmber}</iconColor>
        <iconColorDimmed>${colorAmberDim}</iconColorDimmed>
        <fontPath>${fontRegular}</fontPath>
        <fontSize>0.02</fontSize>
        <entrySpacing>0.015</entrySpacing>
        <letterCase>lowercase</letterCase>
        <zIndex>20</zIndex>
      </helpsystem>

    </view>

  </aspectRatio>

</theme>
