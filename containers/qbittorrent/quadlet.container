# qBittorrent — nedlastingsklient for Radarr og Sonarr
# MERK: StueOS forventer at qBittorrent kjører på en dedikert server i nettverket.
#       Denne quadlet-filen er kun for de som ønsker lokal kjøring på StueOS-maskinen.
# WebUI: http://localhost:8080  (standard passord: adminadmin ved første oppstart)
# Koble til Radarr/Sonarr: Settings → Download Clients → qBittorrent → localhost:8080

[Unit]
Description=qBittorrent - Download Client
After=network.target

[Container]
Image=lscr.io/linuxserver/qbittorrent:latest
AutoUpdate=registry
ContainerName=qbittorrent

PublishPort=8080:8080
PublishPort=6881:6881
PublishPort=6881:6881/udp
Volume=%h/media/config/qbittorrent:/config:Z
Volume=%h/media/downloads:/downloads:Z

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Oslo
Environment=WEBUI_PORT=8080

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
