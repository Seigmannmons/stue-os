[Unit]
Description=StueOS Bluesound Node Control Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stueos
EnvironmentFile=/etc/stueos/services/bluesound-control.env
ExecStart=/usr/bin/python3 /opt/stueos/services/bluesound-control/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
