[Unit]
Description=StueOS Homey Control — Kodi-hendelser til Homey-flyt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stueos
EnvironmentFile=/etc/stueos/services/homey-control.env
ExecStart=/usr/bin/python3 /opt/stueos/services/homey-control/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
