[Unit]
Description=StueOS Denon AVR Control Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stueos
EnvironmentFile=/etc/stueos/services/denon-control.env
ExecStart=/usr/bin/python3 /opt/stueos/services/denon-control/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
