# StueOS — Custom Bazzite image for living room PC
# Base: ghcr.io/ublue-os/bazzite-nvidia
#
# Build:  podman build -t stueos -f build/Containerfile .
# Rebase: rpm-ostree rebase ostree-unverified-registry:ghcr.io/seigmannmons/stueos:latest

ARG BASE_IMAGE="ghcr.io/ublue-os/bazzite-nvidia"
ARG FEDORA_MAJOR_VERSION="45"

FROM ${BASE_IMAGE}:stable-${FEDORA_MAJOR_VERSION}

# ── System packages via rpm-ostree ─────────────────────────────────────
# Kodi comes from RPMFusion (included in Bazzite)
# Flatpaks (Kodi skin, EmuDeck) are handled in build/firstboot.sh
RUN rpm-ostree install \
        libbluray \
        libbluray-utils \
        libcec \
        lirc \
        lcdproc \
        uxplay \
        avahi \
        nss-mdns \
        mpv \
        python3-pip \
        ntfy \
    && ostree container commit

# ── go2tv (Chromecast receiver) — download release binary ──────────────
ARG GO2TV_VERSION="1.9.5"
RUN curl -fsSL \
        "https://github.com/alexballas/go2tv/releases/download/v${GO2TV_VERSION}/go2tv-Linux_x86_64.tar.gz" \
        | tar -xz -C /usr/local/bin go2tv \
    && chmod +x /usr/local/bin/go2tv \
    && ostree container commit

# ── Python-tjenester (Denon AVR + Bluesound) ───────────────────────────
COPY services/ /opt/stueos/services/
RUN pip3 install --prefix=/usr \
        denonavr \
        httpx \
        "fastapi>=0.110" \
        "uvicorn[standard]" \
    && ostree container commit

# ── Systemd-tjenester ─────────────────────────────────────────────────
COPY build/systemd/ /usr/lib/systemd/system/
COPY build/systemd-preset/50-stueos.preset /usr/lib/systemd/system-preset/
COPY config/systemd-drop-ins/uxplay.service.d/ /usr/lib/systemd/system/uxplay.service.d/

# ── Konfigurasjonsmaler ───────────────────────────────────────────────
# Kopieres til /etc/skel slik at nye brukere får dem automatisk
COPY config/lirc/           /etc/lirc/
COPY config/kodi/           /etc/skel/.kodi/
COPY config/themes/         /usr/share/stueos/themes/

# ── StueOS-scripts og -ressurser ──────────────────────────────────────
COPY scripts/check-hardware.sh /usr/share/stueos/check-hardware.sh
COPY setup.sh               /usr/share/stueos/setup.sh
COPY build/firstboot.sh     /usr/share/stueos/firstboot.sh
COPY build/update-check.sh  /usr/share/stueos/update-check.sh
RUN chmod +x /usr/share/stueos/setup.sh /usr/share/stueos/firstboot.sh /usr/share/stueos/update-check.sh

# ── Just-oppskrifter (Justfile) ───────────────────────────────────────
COPY build/Justfile         /usr/share/stueos/Justfile

# ── OCI-metadata ─────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="StueOS"
LABEL org.opencontainers.image.description="Custom Bazzite-based living room OS — Antec Fusion Remote, Kodi, Steam, EmuDeck"
LABEL org.opencontainers.image.url="https://github.com/Seigmannmons/stue-os"
LABEL org.opencontainers.image.source="https://github.com/Seigmannmons/stue-os"
LABEL org.opencontainers.image.vendor="Seigmannmons"
